<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!-- ===== Session cookie hardening ===== -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>true</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- ===== Session cookie: SameSite=Strict ===== -->
    <filter>
        <filter-name>SessionCookieFilter</filter-name>
        <filter-class>com.exam.filter.SessionCookieFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>SessionCookieFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ===== Rate Limit Filter ===== -->
    <filter>
        <filter-name>RateLimitFilter</filter-name>
        <filter-class>com.exam.filter.RateLimitFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>RateLimitFilter</filter-name>
        <url-pattern>/login.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>RateLimitFilter</filter-name>
        <url-pattern>/register.jsp</url-pattern>
    </filter-mapping>

    <!-- ===== CSRF Filter ===== -->
    <filter>
        <filter-name>CsrfFilter</filter-name>
        <filter-class>com.exam.filter.CsrfFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CsrfFilter</filter-name>
        <url-pattern>/login.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>CsrfFilter</filter-name>
        <url-pattern>/register.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>CsrfFilter</filter-name>
        <url-pattern>/exam.jsp</url-pattern>
    </filter-mapping>


    <!-- ===== Security Headers ===== -->
    <filter>
        <filter-name>SecurityHeadersFilter</filter-name>
        <filter-class>com.exam.filter.SecurityHeadersFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>SecurityHeadersFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

</web-app>